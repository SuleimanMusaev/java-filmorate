				{
					"name": "DELETE Удалить пользователя 1 (каскадное удаление)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Пользователь удален', function() {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"// Проверяем каскадное удаление",
									"setTimeout(function() {",
									"    const baseUrl = pm.collectionVariables.get('base_url');",
									"    const user1Id = pm.collectionVariables.get('cascade_user1_id');",
									"    const user2Id = pm.collectionVariables.get('cascade_user2_id');",
									"    const filmId = pm.collectionVariables.get('cascade_film_id');",
									"    ",
									"    console.log('🔍 Проверка каскадного удаления...');",
									"    ",
									"    // 1. Проверяем что пользователь 1 удален",
									"    pm.sendRequest({",
									"        url: baseUrl + '/users/' + user1Id,",
									"        method: 'GET'",
									"    }, function(err, res) {",
									"        if (res && res.code === 404) {",
									"            console.log('✅ Пользователь 1 удален');",
									"        } else {",
									"            console.log('❌ Пользователь 1 не удален, статус:', res ? res.code : 'нет ответа');",
									"        }",
									"    });",
									"    ",
									"    // 2. Проверяем что пользователь 2 не имеет друзей",
									"    pm.sendRequest({",
									"        url: baseUrl + '/users/' + user2Id + '/friends',",
									"        method: 'GET'",
									"    }, function(err, res) {",
									"        if (res && res.code === 200) {",
									"            const friends = res.json();",
									"            if (friends.length === 0) {",
									"                console.log('✅ Дружба удалена у пользователя 2');",
									"            } else {",
									"                console.log('❌ У пользователя 2 остались друзья:', friends.length);",
									"            }",
									"        }",
									"    });",
									"    ",
									"    // 3. Проверяем что лайк удален у фильма",
									"    pm.sendRequest({",
									"        url: baseUrl + '/films/' + filmId,",
									"        method: 'GET'",
									"    }, function(err, res) {",
									"        if (res && res.code === 200) {",
									"            const film = res.json();",
									"            const hasLike = film.likes && film.likes.includes(parseInt(user1Id));",
									"            if (!hasLike) {",
									"                console.log('✅ Лайк пользователя 1 удален из фильма');",
									"            } else {",
									"                console.log('❌ Лайк пользователя 1 остался у фильма');",
									"            }",
									"        }",
									"    });",
									"}, 1500);"
								],
								"type": "text/javascript"
							}
						}
					],
